{
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "buildCommand": "npm --prefix client install && npm --prefix client run build",
  "outputDirectory": "client/dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/((?!portal-api/|account-api/|network-api/|portal-assets/|person-photos/|grant-documents/|interaction-files/|unsubscribe$|v/|watch/|survey/|e/|auction/|ticket/|you/|volunteer/|volunteer-with/|billing/cancel/|recurring/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-giul2Tz10285XN/XwQF702DkrNpZYabkzSOGObdIDvg=' 'sha256-6mfQDUBgxFbQM1GVn9xdVyoLoF5uyzEJq0fBU+2w3qY='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https: https://nonprofit-erp-production.up.railway.app; media-src 'self' blob: https: https://nonprofit-erp-production.up.railway.app; connect-src 'self' https://nonprofit-erp-production.up.railway.app https://*.sentry.io; frame-src 'self' blob: data: https://nonprofit-erp-production.up.railway.app https://www.youtube-nocookie.com https://www.youtube.com https://player.vimeo.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/portal-api/:path*",
      "destination": "https://nonprofit-erp-production.up.railway.app/portal/:path*"
    },
    {
      "source": "/account-api/:path*",
      "destination": "https://nonprofit-erp-production.up.railway.app/account/:path*"
    },
    {
      "source": "/network-api/:path*",
      "destination": "https://nonprofit-erp-production.up.railway.app/network/:path*"
    },
    {
      "source": "/portal-assets/:path*",
      "destination": "https://nonprofit-erp-production.up.railway.app/portal-assets/:path*"
    },
    {
      "source": "/person-photos/:path*",
      "destination": "https://nonprofit-erp-production.up.railway.app/person-photos/:path*"
    },
    {
      "source": "/grant-documents/:path*",
      "destination": "https://nonprofit-erp-production.up.railway.app/grant-documents/:path*"
    },
    {
      "source": "/interaction-files/:path*",
      "destination": "https://nonprofit-erp-production.up.railway.app/interaction-files/:path*"
    },
    {
      "source": "/unsubscribe",
      "destination": "https://nonprofit-erp-production.up.railway.app/unsubscribe"
    },
    {
      "source": "/v/:path*",
      "destination": "https://nonprofit-erp-production.up.railway.app/v/:path*"
    },
    {
      "source": "/watch/:path*",
      "destination": "https://nonprofit-erp-production.up.railway.app/watch/:path*"
    },
    {
      "source": "/survey/:path*",
      "destination": "https://nonprofit-erp-production.up.railway.app/survey/:path*"
    },
    {
      "source": "/e/:path*",
      "destination": "https://nonprofit-erp-production.up.railway.app/e/:path*"
    },
    {
      "source": "/auction/:path*",
      "destination": "https://nonprofit-erp-production.up.railway.app/auction/:path*"
    },
    {
      "source": "/ticket/:path*",
      "destination": "https://nonprofit-erp-production.up.railway.app/ticket/:path*"
    },
    {
      "source": "/you/:path*",
      "destination": "https://nonprofit-erp-production.up.railway.app/you/:path*"
    },
    {
      "source": "/volunteer/log",
      "destination": "https://nonprofit-erp-production.up.railway.app/volunteer/log"
    },
    {
      "source": "/volunteer/join",
      "destination": "https://nonprofit-erp-production.up.railway.app/volunteer/join"
    },
    {
      "source": "/volunteer-with/:path*",
      "destination": "https://nonprofit-erp-production.up.railway.app/volunteer-with/:path*"
    },
    {
      "source": "/volunteer/me",
      "destination": "https://nonprofit-erp-production.up.railway.app/volunteer/me"
    },
    {
      "source": "/volunteer/me/:path*",
      "destination": "https://nonprofit-erp-production.up.railway.app/volunteer/me/:path*"
    },
    {
      "source": "/volunteer/:slug/signup",
      "destination": "https://nonprofit-erp-production.up.railway.app/volunteer/:slug/signup"
    },
    {
      "source": "/volunteer/:slug",
      "destination": "https://nonprofit-erp-production.up.railway.app/volunteer/:slug"
    },
    {
      "source": "/billing/cancel/:token",
      "destination": "https://nonprofit-erp-production.up.railway.app/billing/cancel/:token"
    },
    {
      "source": "/recurring/update-card",
      "destination": "https://nonprofit-erp-production.up.railway.app/recurring/update-card"
    },
    {
      "source": "/recurring/proposal",
      "destination": "https://nonprofit-erp-production.up.railway.app/recurring/proposal"
    },
    {
      "source": "/recurring/proposal/confirm",
      "destination": "https://nonprofit-erp-production.up.railway.app/recurring/proposal/confirm"
    },
    {
      "source": "/giving",
      "destination": "/giving.html"
    },
    {
      "source": "/give/:path*",
      "destination": "/give.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ]
}
