#!/usr/bin/env bash
# BUILD-38 Part 2 — the local gate that precedes deploy in solo auto-mode.
#
# BUILD-87 (2026-09-16): THE FULL BATTERY BELONGS TO CI. This hook runs LINT
# plus the suites actually affected by what is being pushed, and nothing else.
# It used to escalate to the whole battery whenever a shared surface changed
# (server.js, db.js, routes/, test infra) — which is most real commits — and a
# six-minute wait on every push is a tax paid on every commit to catch what CI
# catches anyway, a few minutes later, on a machine nobody is waiting at.
#
# THE TRADE, STATED PLAINLY: a shared-surface change now pushes with lint only.
# CI (.github/workflows/ci.yml) still runs the FULL battery on every push and
# still gates the deploy jobs behind it, so nothing reaches production
# unverified — what changed is who waits for it.
#
# Enable once with:  npm run setup:hooks
# Force the full battery locally with:  PREPUSH_FULL=1 git push
# Bypass entirely in a true emergency with:  git push --no-verify
#
# Assumes the local scratch stack is up for whatever suites get selected
# (scratch Postgres :5544 + the API server per tests/README.md). If it is not,
# the selected suites fail loudly — the correct outcome for "don't push blind".
set -u
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root" || exit 1

# ── Lint always. It is two seconds and it catches the class of mistake that
# ── otherwise reaches a browser: a bad import, a hook called conditionally, a
# ── JSX tag that does not close.
echo "[pre-push] lint"
if ! (cd client && npx eslint src --max-warnings=-1); then
  echo ""
  echo "[pre-push] BLOCKED: lint errors. Fix them, or 'git push --no-verify' only if you truly mean to."
  exit 1
fi

# ── TDZ SELF-REFERENCES ALWAYS. Two seconds, and it is the ONE class of mistake
# ── in this codebase that reaches a browser past every other gate: `const INK =
# ── INK;` parses, type-checks, lints and passes every server suite, then replaces
# ── a whole screen with its error boundary at runtime.
#
# It has now cost FIVE builds (BUILD-84, 89, 95, 96, 102), and four of those five
# were a blanket string replace that rewrote a declaration along with its uses. A
# scanner nobody runs is worth nothing, so it runs here rather than being
# remembered — Jonathan's instruction, 2026-09-25.
#
# ONLY the self-reference half is gated. `--all` reports ~200 read-above
# candidates that are mostly function parameters sharing a spelling with a later
# binding; it cannot be made exact without real scope analysis, and a gate with
# false positives is a gate people learn to bypass. A self-reference needs no
# judgement at all: it is always a bug.
echo "[pre-push] tdz-scan (self-references)"
if ! node scripts/tdz-scan.js; then
  echo ""
  echo "[pre-push] BLOCKED: a const reads itself. That is always a bug — it throws"
  echo "[pre-push] ReferenceError at runtime and takes the screen to its error boundary."
  echo "[pre-push] Fix the declaration; do not --no-verify past this one."
  exit 1
fi

zero=0000000000000000000000000000000000000000
mode=""
reason=""
selection=""

if [ "${PREPUSH_FULL:-}" = "1" ]; then
  mode="FULL"; reason="PREPUSH_FULL=1 forced"
else
  # Standard pre-push stdin: <local ref> <local sha> <remote ref> <remote sha>
  while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    [ "$local_sha" = "$zero" ] && continue   # branch deletion — nothing to test
    if [ "$remote_sha" = "$zero" ]; then
      mode="ci"; reason="new branch $local_ref (no remote base)"
      break
    fi
    range="${remote_sha}..${local_sha}"
    out="$(bash tests/affected.sh "$range" </dev/null)"
    nfiles=$(git diff --name-only "$range" -- 2>/dev/null | grep -c . || true)
    if [ "$out" = "FULL" ]; then
      # "Everything is affected" is precisely the case this hook no longer
      # runs locally. Say so, name CI as the gate, and move on.
      mode="ci"; reason="a shared surface changed in $range ($nfiles changed files)"
      break
    elif [ -n "$out" ]; then
      mode="list"; reason="affected.sh → suite subset for $range ($nfiles changed files)"
      for s in $out; do
        case " $selection " in *" $s "*) ;; *) selection="$selection $s" ;; esac
      done
    else
      [ -z "$mode" ] && { mode="skip"; reason="affected.sh → no test-relevant changes in $range ($nfiles changed files)"; }
    fi
  done
fi

[ -z "$mode" ] && { mode="ci"; reason="no pushed refs parsed"; }
selection="${selection# }"

case "$mode" in
  skip)
    echo "[pre-push] $reason"
    echo "[pre-push] lint green, no test-relevant changes — pushing (CI runs the full battery)"
    exit 0 ;;
  ci)
    echo "[pre-push] $reason"
    echo "[pre-push] lint green — the full battery for this change runs in CI, not here."
    echo "[pre-push] (PREPUSH_FULL=1 git push to run it locally anyway)"
    exit 0 ;;
  FULL)
    echo "[pre-push] mode: FULL battery — $reason"
    if ! bash tests/run-all.sh; then
      echo ""
      echo "[pre-push] BLOCKED: tests failed. Fix them, or 'git push --no-verify' only if you truly mean to."
      exit 1
    fi ;;
  list)
    echo "[pre-push] mode: affected suites only — $reason"
    echo "[pre-push] running: $selection"
    if ! SUITES="$selection" bash tests/run-all.sh; then
      echo ""
      echo "[pre-push] BLOCKED: tests failed. Fix them, or 'git push --no-verify' only if you truly mean to."
      exit 1
    fi ;;
esac
echo "[pre-push] green — pushing."
